{
  "name": "garage-sale-api",
  "version": "1.0.0",
  "description": "API for a garage sale mobile app",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --ext js,mjs,json,html index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rimraf dist",
    "build": "node build.js",
    "build:local": "node build.js && copy .env dist\\.env 2>nul || cp .env dist/.env 2>/dev/null || echo '.env not found'",
    "build:php": "node build-php.js",
    "build:php:reset": "node build-php.js --reset-db",
    "build:php:local": "node build-php.js && copy .env dist-php\\api\\config.php 2>nul || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "copyfiles": "^2.4.1",
    "html-minifier-terser": "^7.2.0",
    "nodemon": "^2.0.22",
    "rimraf": "^6.1.3",
    "terser": "^5.48.0"
  }
}
