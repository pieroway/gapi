# Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=gapi

# Server Configuration
PORT=61571

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Admin Panel Password
# Protects /admin.html and admin API routes (GET /api/reports, DELETE /api/reports/:id, etc.)
ADMIN_TOKEN=your_admin_password_here

# For remote/production deployment, uncomment and configure:
# DB_HOST=your-remote-host
# DB_PORT=3306
# DB_USER=your-remote-user
# DB_PASSWORD=your-remote-password
# DB_NAME=your-database-name
