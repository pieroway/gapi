# Docker development: copy to php/.env (ignored by Git), or set shell variables.
# Never use production credentials in the local development stack.
GOOGLE_MAPS_API_KEY=
GAPI_HTTP_PORT=8080
GAPI_DB_PORT=3308
# Set a unique, high-entropy admin bearer token to enable report moderation.
ADMIN_TOKEN=

# Shared hosting reads these settings from its document-root .user.ini or
# environment. Configure them on the host; do not include them in deploy/.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_NAME=your_database_name
# APP_DEBUG=0

# Hosting report moderation also requires ADMIN_TOKEN in the server environment
# or document-root .user.ini. Leave it unset to disable administrative access.
