# =================================================================
# Garage Sale Finder - Apache URL Routing
# =================================================================
# This file replaces the Express.js routing in index.js.
# It requires mod_rewrite to be enabled on your Apache server
# (it is enabled by default on virtually all shared hosting).
# =================================================================

Options -Indexes

# Server configuration must never be downloadable, even when it exists on the host.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
RewriteEngine On
# Uploaded content must not execute as server-side code.
RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|cgi|pl|shtml)(\.|$) - [F,END,NC]

# Forward bearer authorization to PHP on CGI/FastCGI hosting.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# --- Security: Block direct access to PHP files in /api/ ---
# Users should never hit api/*.php directly; all requests go through
# the clean /api/... URLs rewritten below.
RewriteRule ^api/config\.php$ - [F,L]

# --- API Routes ---
# Route /api/config to api/maps_config.php
RewriteRule ^api/config$ api/maps_config.php [QSA,END]

# Route /api/events* to api/events.php
RewriteRule ^api/events(/.*)?$ api/events.php [QSA,L]

# Route /api/sale_types to api/sale_types.php
RewriteRule ^api/sale_types(/.*)?$ api/sale_types.php [QSA,L]

# Route /api/item_categories to api/item_categories.php
RewriteRule ^api/item_categories(/.*)?$ api/item_categories.php [QSA,L]

# Route /api/reports* to api/reports.php
RewriteRule ^api/reports(/.*)?$ api/reports.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/ - [R=404,END]

# --- SPA Fallback ---
# For any request that is NOT a real file or directory,
# serve index.html so the client-side app handles routing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!api/).*$ index.html [L]
